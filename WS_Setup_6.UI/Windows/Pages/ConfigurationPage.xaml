<UserControl x:Class="WS_Setup_6.UI.Windows.Pages.ConfigurationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:Controls="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:conv="clr-namespace:WS_Setup_6.UI.Converters"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:WS_Setup_6.UI.ViewModels;assembly=WS_Setup_6.UI"
             xmlns:pages="clr-namespace:WS_Setup_6.UI.ViewModels.Pages;assembly=WS_Setup_6.UI">

    <UserControl.Resources>
        <QuadraticEase x:Key="QuadraticEaseOut"
                       EasingMode="EaseOut" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />

        <!-- Shared row layout -->
        <Style x:Key="FormRowStyle"
               TargetType="StackPanel">
            <Setter Property="Orientation"
                    Value="Horizontal" />
            <Setter Property="Margin"
                    Value="0,0,0,8" />
        </Style>

        <!-- Default spacing for children -->
        <Style TargetType="FrameworkElement">
            <Setter Property="Margin"
                    Value="0,0,0,16" />
        </Style>
    </UserControl.Resources>

    <StackPanel Margin="24">
        <!-- Header -->
        <TextBlock Text="Setup"
                   FontSize="18"
                   Foreground="{DynamicResource MahApps.Brushes.Accent}"
                   Margin="100,0,0,25"
                   FontWeight="SemiBold" />

        <!-- Domain Name -->
        <StackPanel Style="{StaticResource FormRowStyle}">
            <TextBlock Text="Domain Name:"
                       Foreground="{DynamicResource MahApps.Brushes.Accent}"
                       FontSize="14"
                       Width="120"
                       VerticalAlignment="Center" />
            <TextBox Text="{Binding DomainName, UpdateSourceTrigger=PropertyChanged}"
                     Width="400"
                     Margin="10,0,0,0"
                     Controls:TextBoxHelper.Watermark="Leave blank to skip…" />
        </StackPanel>

        <!-- Installer Path -->
        <StackPanel Style="{StaticResource FormRowStyle}">
            <TextBlock Text="Ninja Installer Path:"
                       Foreground="{DynamicResource MahApps.Brushes.Accent}"
                       FontSize="14"
                       Width="120"
                       VerticalAlignment="Center" />
            <TextBox Text="{Binding InstallPath, UpdateSourceTrigger=PropertyChanged}"
                     Width="400"
                     Margin="10,0,0,0"
                     Controls:TextBoxHelper.Watermark="Leave blank to skip…" />
        </StackPanel>

        <!-- Buttons -->
        <WrapPanel Margin="0,16,0,0"
                   ItemWidth="140">
            <Button Content="FIND AGENT"
                    Command="{Binding TestPathCommand}">
                <Button.ToolTip>
                    <ToolTip Content="This will auto-seed the path from the Desktop, if the installer is on it."></ToolTip>
                </Button.ToolTip>
            </Button>
            <Button Content="BEGIN ONBOARD"
                    Command="{Binding BeginOnboardCommand}"
                    IsEnabled="{Binding CanBeginOnboard}" />
        </WrapPanel>

        <!-- Progress + Status -->
        <Grid x:Name="ProgressArea"
              Margin="0,40,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Controls:MetroProgressBar x:Name="ProgressBar"
                                       Grid.Row="0"
                                       Height="16"
                                       Width="520"
                                       Margin="0,8,0,4"
                                       HorizontalAlignment="Left"
                                       IsIndeterminate="True"
                                       Visibility="{Binding IsProgressVisible, Converter={StaticResource BoolToVis}}"
                                       Foreground="{DynamicResource AccentColorBrush}"
                                       BorderBrush="Black"
                                       BorderThickness="1"
                                       Opacity="1" />

            <TextBlock Grid.Row="1"
                       Text="{Binding StatusText}"
                       FontStyle="Italic"
                       Foreground="{DynamicResource MahApps.Brushes.Accent}"
                       Margin="0,12,0,0"
                       TextWrapping="Wrap" />
        </Grid>
    </StackPanel>
</UserControl>